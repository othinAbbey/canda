# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgres://canda:canda@localhost:5432/canda

# --- Server ------------------------------------------------------------------
PORT=8100
HOST=127.0.0.1
# Websites allowed to call this API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# --- Security ----------------------------------------------------------------
# Long random string. If empty a random one is generated once and stored in the database.
TOKEN_SECRET=
TOKEN_HOURS=12
# true: anyone can create an account (role "user": read-only catalog, own BOQ jobs). false: admins create accounts.
ALLOW_SIGNUP=true
RESET_MINUTES=60

# --- Limits --------------------------------------------------------------------
MAX_UPLOAD_MB=25
# Placeholder for future subscriptions: when true, plan limits are enforced.
ENFORCE_PLAN_LIMITS=false

# --- BOQ service (separate project: canda-boq-service) -------------------------
BOQ_SERVICE_URL=http://127.0.0.1:8000
BOQ_SERVICE_KEY=

# Fill the database with districts, materials and sample rates on first start.
SEED=true
