# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgres://canda:canda@localhost:5432/canda

# --- Server ------------------------------------------------------------------
PORT=8100
HOST=127.0.0.1
# Websites allowed to call this API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

# --- Security ----------------------------------------------------------------
# Long random string. If empty a random one is generated once and stored in the database.
TOKEN_SECRET=
TOKEN_HOURS=12
# true: anyone can create an account (role "user": read-only catalog, own BOQ jobs). false: admins create accounts.
ALLOW_SIGNUP=true
RESET_MINUTES=60

# --- Limits --------------------------------------------------------------------
MAX_UPLOAD_MB=25
# Placeholder for future subscriptions: when true, plan limits are enforced.
ENFORCE_PLAN_LIMITS=false

# --- AI bid reading (Claude) -------------------------------------------------------
# Key from console.anthropic.com (Settings > API keys). Without it, the built-in reader lists what it can from
# notice web pages only (it cannot read PDFs). Each reading is billed to this key.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# true: start reading as soon as a tender is marked "interested" (or "bidding"). false: only when someone clicks Read.
AI_AUTO_READ=true
# The project assistant (the "Ask the assistant" button). Uses the same key.
AI_ASSISTANT_MODEL=claude-haiku-5-5
# Questions per company per month (0 = no limit).
AI_MONTHLY_QUESTIONS=1000
# Site Chat: the bot reads project-room messages and drafts site logs / issues (people check and save them).
AI_CHAT_BOT=true
# Chat messages the bot reads per company per month (0 = no limit).
AI_MONTHLY_CHAT_READS=3000

# --- BOQ service (separate project: canda-boq-service) -------------------------
BOQ_SERVICE_URL=http://127.0.0.1:8000
BOQ_SERVICE_KEY=

# Fill the database with districts, materials and sample rates on first start.
SEED=true

# Database encryption: true | false. Leave unset to decide automatically (on for hosted databases, off for localhost).
# PGSSL=

# Tender feeds: World Bank, African Development Bank and UNDP are searched by default, no keys needed.
# AFDB_FEED=false or UNDP_FEED=false switches one off.

# Buildsuite360's own daily social media posts (Social Posts page, Buildsuite360 staff only)
# The Buildsuite360 team: ONLY these sign-in emails see "Adverts & Social Posts" and the "Make advert" buttons,
# whatever their role or company. Comma-separated. Empty = nobody.
BUILDSUITE_TEAM_EMAILS=you@buildsuite360.org
# Make a draft each morning from this hour, Kampala time. The draft waits for a person to approve it; nothing is posted by itself.
SOCIAL_AUTO=true
SOCIAL_HOUR=6
SOCIAL_COUNTRY=Uganda

# Uganda's Electronic Government Procurement portal (eGP, egpuganda.go.ug) as a tender source. Set to false to switch it off.
EGP_FEED=true

# Voiceovers for the Buildsuite360 team's adverts (Microsoft Azure text to speech). Leave empty to switch off.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
# Optional: another Azure voice. Default: en-KE-AsiliaNeural (female, Kenyan English).
# AZURE_SPEECH_VOICE=en-KE-AsiliaNeural
